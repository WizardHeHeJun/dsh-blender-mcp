{
  "name": "dsh-blender-mcp",
  "version": "0.1.0",
  "description": "DSH 一键适配 Blender MCP：自动注册 MCP 服务端、安装 Blender 侧插件，并提供一个只读体检工具排查连不上的原因",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "blender",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "lib/plugin.mjs",
  "exports": {
    ".": "./lib/plugin.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-blender-mcp": "./lib/cli.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sync-addon": "node scripts/sync-addon.mjs",
    "sync-addon:check": "node scripts/sync-addon.mjs --check"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.3 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3 <0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
